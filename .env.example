# ------------------------------------------------------------------
# CSI FSE-01 production events backend - local environment template
# Copy to .env and adjust. NEVER commit real secrets.
# ------------------------------------------------------------------

# PostgreSQL connection (dev database). Tests use TEST_DATABASE_URL.
DATABASE_URL=postgresql://fse:fse_dev_password@localhost:5432/production_dashboard
TEST_DATABASE_URL=postgresql://fse:fse_dev_password@localhost:5432/production_dashboard_test

# HTTP port for the REST API
PORT=3000

# MQTT simulator integration
MQTT_ENABLED=true
MQTT_BROKER_HOST=152.42.238.142
MQTT_BROKER_PORT=1883
MQTT_CANDIDATE_ID=08

# Optional: point MQTT at a local broker instead (e.g. for offline work)
# MQTT_BROKER_HOST=127.0.0.1

# Log level: debug | info | warn | error
LOG_LEVEL=info
